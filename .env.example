# Copy to .env for local dev (or set in Railway dashboard for production)

# Users. For multiple people (cost-splitting), set CARDLISTER_USERS as a
# comma-separated list of username:password pairs:
#   CARDLISTER_USERS=brock:s3cret,sam:hunter2
# If CARDLISTER_USERS is unset, the app falls back to a single "owner" user whose
# password is CARDLISTER_PASSWORD below (leave the username blank when logging in).
CARDLISTER_USERS=
CARDLISTER_PASSWORD=changeme

# Long random string used to sign JWT session tokens
JWT_SECRET=replace-with-a-long-random-string

# Anthropic API key (omit to use mock mode)
ANTHROPIC_API_KEY=

# Subscription-billed scan fallback (optional). Generate with `claude setup-token`
# (requires a Claude Pro/Max plan; token lasts ~1 year — rotate it). When the API
# key is missing or out of credits, scans run through the Claude Code CLI and bill
# the subscription instead of failing. Requires the `claude` CLI on PATH (the
# Dockerfile installs it).
CLAUDE_CODE_OAUTH_TOKEN=

# Credits-exhausted alerts (optional). Email goes to ALERT_EMAILS via the mailer
# below. For a phone push: install the ntfy app (ntfy.sh), subscribe to a private
# topic name (treat it like a password — anyone who knows it can read alerts),
# and set it here. NTFY_SERVER overrides the ntfy host (default https://ntfy.sh).
# BILLING_ALERT_THROTTLE_SECONDS spaces out repeat alerts (default 21600 = 6h).
# Keep real values for NTFY_SERVER and BILLING_ALERT_THROTTLE_SECONDS.
# An empty throttle crashes startup (int("")), and an empty NTFY_SERVER blanks
# the ntfy host. Set NTFY_TOPIC when enabling ntfy alerts.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
BILLING_ALERT_THROTTLE_SECONDS=21600


# Vision tuning (all optional — sensible defaults baked in).
# CLAUDE_MODEL: override the vision model, e.g. claude-sonnet-4-6 to cut cost.
# CLAUDE_EFFORT: low | medium | high — thinking depth vs. cost tradeoff.
# VISION_MAX_IMAGE_PX: long-edge cap before upload (0 disables downsampling).
# SUBSCRIPTION_SCAN_TIMEOUT: seconds before the headless `claude -p` fallback
# is killed (default 150; parsed at import — keep a real value, not empty).
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_EFFORT=medium
VISION_MAX_IMAGE_PX=1300
SUBSCRIPTION_SCAN_TIMEOUT=150

# Set to "production" to make the app refuse to boot with default/insecure
# secrets. Auto-detected on Railway; leave blank (development) for local dev.
APP_ENV=

# Google Sheets sync (optional). Paste the FULL service account JSON as a single string.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# eBay API pricing (optional). When both are set, the eBay API becomes the
# primary comp source; until then the app falls back to the HTML scrapers.
# EBAY_APP_ID = App ID (OAuth client_id), EBAY_CERT_ID = Cert ID (client_secret).
EBAY_APP_ID=
EBAY_CERT_ID=
# Optional: marketplace (default EBAY_US) and environment ("production"/"sandbox").
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENV=production
# eBay marketplace account-deletion compliance (required to enable a production
# keyset unless exempt). Generate a 32-80 char random token, paste the SAME value
# here and in the portal's notification-endpoint form, and set the endpoint URL
# to this app's public route (must match the portal field exactly):
#   https://<your-prod-host>/api/ebay-compliance/account-deletion
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=

# Call-up alert emails (optional). SMTP_USERNAME = Gmail address; SMTP_PASSWORD =
# a Gmail App Password (requires 2-Step Verification; myaccount.google.com →
# Security → App passwords). ALERT_EMAILS = comma-separated recipients.
# The news ticker works without these — only emails need them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAILS=
# Preferred on Railway (outbound SMTP is blocked there): SendGrid HTTP API.
# Free tier; verify ALERT_FROM as a Single Sender in SendGrid first.
SENDGRID_API_KEY=
ALERT_FROM=
# Minutes between MLB call-up polls (default 15); NEWS_FEEDS overrides RSS urls.
# DISABLE_CALLUP_POLLER=1 skips the in-process poller (tests/local dev).
CALLUP_POLL_MINUTES=15
NEWS_FEEDS=
DISABLE_CALLUP_POLLER=

# Where SQLite stores its file. On Railway set to /data/cardlister.db (with a volume).
DB_PATH=./cardlister.db
