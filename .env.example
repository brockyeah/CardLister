# Copy to .env for local dev (or set in Railway dashboard for production)

# Login password the user types in
CARDLISTER_PASSWORD=changeme

# Long random string used to sign JWT session tokens
JWT_SECRET=replace-with-a-long-random-string

# Anthropic API key (omit to use mock mode)
ANTHROPIC_API_KEY=

# Google Sheets sync (optional). Paste the FULL service account JSON as a single string.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# eBay app id for Browse API fallback pricing (optional, Phase 2)
EBAY_APP_ID=

# Where SQLite stores its file. On Railway set to /data/cardlister.db (with a volume).
DB_PATH=./cardlister.db
