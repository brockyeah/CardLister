# Copy to .env for local dev (or set in Railway dashboard for production)

# Users. For multiple people (cost-splitting), set CARDLISTER_USERS as a
# comma-separated list of username:password pairs:
#   CARDLISTER_USERS=brock:s3cret,sam:hunter2
# If CARDLISTER_USERS is unset, the app falls back to a single "owner" user whose
# password is CARDLISTER_PASSWORD below (leave the username blank when logging in).
CARDLISTER_USERS=
CARDLISTER_PASSWORD=changeme

# Long random string used to sign JWT session tokens
JWT_SECRET=replace-with-a-long-random-string

# Anthropic API key (omit to use mock mode)
ANTHROPIC_API_KEY=

# Vision tuning (all optional — sensible defaults baked in).
# CLAUDE_MODEL: override the vision model, e.g. claude-sonnet-4-6 to cut cost.
# CLAUDE_EFFORT: low | medium | high — thinking depth vs. cost tradeoff.
# VISION_MAX_IMAGE_PX: long-edge cap before upload (0 disables downsampling).
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_EFFORT=medium
VISION_MAX_IMAGE_PX=1300

# Set to "production" to make the app refuse to boot with default/insecure
# secrets. Auto-detected on Railway; leave blank (development) for local dev.
APP_ENV=

# Google Sheets sync (optional). Paste the FULL service account JSON as a single string.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# eBay API pricing (optional). When both are set, the eBay API becomes the
# primary comp source; until then the app falls back to the HTML scrapers.
# EBAY_APP_ID = App ID (OAuth client_id), EBAY_CERT_ID = Cert ID (client_secret).
EBAY_APP_ID=
EBAY_CERT_ID=
# Optional: marketplace (default EBAY_US) and environment ("production"/"sandbox").
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENV=production

# Where SQLite stores its file. On Railway set to /data/cardlister.db (with a volume).
DB_PATH=./cardlister.db
